# Copy to .env (same directory) and fill in real values. .env is gitignored.
# Double underscore maps to config sections: ConnectionStrings__Default -> ConnectionStrings:Default

# PostgreSQL connection string
ConnectionStrings__Default=Host=localhost;Port=5432;Database=medhistory;Username=medhistory;Password=CHANGE_ME

# Login password for the app (single shared password)
Auth__Password=CHANGE_ME
