<?xml version="1.0" encoding="utf-8"?>
<root>
  <!--
    Thai for the vocabulary that appears in more than one area. Anything used by a single view
    belongs in that view's own file under Resources/Views/<Controller>/<View>.th.resx instead.

    The <data name> is the English source text, so there is no en-US file: an unlocalised lookup
    returns the key, which already reads correctly. Additions here should stay append-only —
    parallel slices all write to this one file.
  -->
  <xsd:schema id="root" xmlns="" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata">
    <xsd:import namespace="http://www.w3.org/XML/1998/namespace" />
    <xsd:element name="root" msdata:IsDataSet="true">
      <xsd:complexType>
        <xsd:choice maxOccurs="unbounded">
          <xsd:element name="metadata">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" />
              </xsd:sequence>
              <xsd:attribute name="name" use="required" type="xsd:string" />
              <xsd:attribute name="type" type="xsd:string" />
              <xsd:attribute name="mimetype" type="xsd:string" />
              <xsd:attribute ref="xml:space" />
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="assembly">
            <xsd:complexType>
              <xsd:attribute name="alias" type="xsd:string" />
              <xsd:attribute name="name" type="xsd:string" />
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="data">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" msdata:Ordinal="1" />
                <xsd:element name="comment" type="xsd:string" minOccurs="0" msdata:Ordinal="2" />
              </xsd:sequence>
              <xsd:attribute name="name" type="xsd:string" use="required" msdata:Ordinal="1" />
              <xsd:attribute name="type" type="xsd:string" msdata:Ordinal="3" />
              <xsd:attribute name="mimetype" type="xsd:string" msdata:Ordinal="4" />
              <xsd:attribute ref="xml:space" />
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="resheader">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" msdata:Ordinal="1" />
              </xsd:sequence>
              <xsd:attribute name="name" type="xsd:string" use="required" />
            </xsd:complexType>
          </xsd:element>
        </xsd:choice>
      </xsd:complexType>
    </xsd:element>
  </xsd:schema>
  <resheader name="resmimetype">
    <value>text/microsoft-resx</value>
  </resheader>
  <resheader name="version">
    <value>2.0</value>
  </resheader>
  <resheader name="reader">
    <value>System.Resources.ResXResourceReader, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>
  <resheader name="writer">
    <value>System.Resources.ResXResourceWriter, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>

  <!-- Actions -->
  <data name="Save" xml:space="preserve">
    <value>บันทึก</value>
  </data>
  <data name="Cancel" xml:space="preserve">
    <value>ยกเลิก</value>
  </data>
  <data name="Delete" xml:space="preserve">
    <value>ลบ</value>
    <comment>Destroys a record for good. "Remove" is the softer one — see below.</comment>
  </data>
  <data name="Remove" xml:space="preserve">
    <value>นำออก</value>
    <comment>Takes a row out of a list; nothing is destroyed.</comment>
  </data>
  <data name="Edit" xml:space="preserve">
    <value>แก้ไข</value>
  </data>
  <data name="Add" xml:space="preserve">
    <value>เพิ่ม</value>
  </data>
  <data name="Back" xml:space="preserve">
    <value>ย้อนกลับ</value>
  </data>

  <!-- Navigation -->
  <data name="Today" xml:space="preserve">
    <value>วันนี้</value>
  </data>
  <data name="History" xml:space="preserve">
    <value>ประวัติ</value>
  </data>
  <data name="Reports" xml:space="preserve">
    <value>รายงาน</value>
  </data>
  <data name="Search" xml:space="preserve">
    <value>ค้นหา</value>
  </data>
  <data name="Types" xml:space="preserve">
    <value>ประเภท</value>
  </data>
  <data name="Logout" xml:space="preserve">
    <value>ออกจากระบบ</value>
  </data>

  <!-- Report names, as the nav flyout and the report hub both list them -->
  <data name="By type" xml:space="preserve">
    <value>ตามประเภท</value>
  </data>
  <data name="Med" xml:space="preserve">
    <value>ยา</value>
  </data>
  <data name="Anxiety" xml:space="preserve">
    <value>ความกังวล</value>
  </data>
  <data name="Weight" xml:space="preserve">
    <value>น้ำหนัก</value>
  </data>
  <data name="Doctor" xml:space="preserve">
    <value>แพทย์</value>
  </data>

  <!-- The five anxiety levels. AnxietyRules.Label returns the key, not the copy — the day widget
       and both the anxiety and doctor reports render the same five names. -->
  <data name="calm" xml:space="preserve">
    <value>สงบ</value>
  </data>
  <data name="ok" xml:space="preserve">
    <value>โอเค</value>
  </data>
  <data name="tense" xml:space="preserve">
    <value>ตึงเครียด</value>
  </data>
  <data name="anxious" xml:space="preserve">
    <value>กังวล</value>
    <comment>The adjective behind "Anxiety" above — the two read as one word in Thai.</comment>
  </data>
  <data name="panic" xml:space="preserve">
    <value>ตื่นตระหนก</value>
  </data>

  <!-- Weight, as the day widget and the weight report both write it -->
  <data name="kg" xml:space="preserve">
    <value>กก.</value>
  </data>

  <!-- Copy every calendar report's header carries -->
  <data name="Back to today" xml:space="preserve">
    <value>กลับไปหน้าวันนี้</value>
    <comment>Same wording the error page uses; that one keeps its own per-view copy.</comment>
  </data>
  <data name="This month" xml:space="preserve">
    <value>เดือนนี้</value>
  </data>
  <data name="Previous month" xml:space="preserve">
    <value>เดือนก่อนหน้า</value>
    <comment>title on the ← arrow, which has no visible text.</comment>
  </data>
  <data name="Next month" xml:space="preserve">
    <value>เดือนถัดไป</value>
    <comment>title on the → arrow, which has no visible text.</comment>
  </data>

  <!-- Paging, shared by the type report and search -->
  <data name="Newer" xml:space="preserve">
    <value>ใหม่กว่า</value>
  </data>
  <data name="Older" xml:space="preserve">
    <value>เก่ากว่า</value>
  </data>
  <data name="Page {0} of {1}" xml:space="preserve">
    <value>หน้า {0} จาก {1}</value>
  </data>
</root>
