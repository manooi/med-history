@model TypesViewModel
@{
    ViewData["Title"] = "Types";
}

<header class="border-b border-black pb-4">
    <h1 class="font-semibold">Types</h1>
</header>

<form method="post" action="/types" asp-antiforgery="true" class="mt-6 space-y-3">
    <div asp-validation-summary="All" class="text-sm text-neutral-700"></div>

    <div>
        <label for="name" class="block text-sm font-medium">New type</label>
        <input type="text" id="name" name="name" required autocomplete="off"
               maxlength="@EntryTypeRules.NameMaxLength" value="@Model.NewName"
               class="mt-1 w-full border border-black bg-white px-2 py-1 text-sm text-black" />
        <p class="mt-1 text-xs text-neutral-500">
            Added types record a note, photos and a time — no extra fields.
        </p>
    </div>

    <button type="submit"
            class="border border-black bg-white px-4 py-1 text-sm text-black hover:bg-black hover:text-white">
        Add type
    </button>
</form>

<section class="mt-8">
    <ul class="border-y border-neutral-300 divide-y divide-neutral-300">
        @foreach (var type in Model.Types)
        {
            <li class="flex items-center justify-between gap-3 px-1 py-3">
                <span class="flex min-w-0 flex-wrap items-center gap-2">
                    <span class="text-sm font-medium @(type.IsActive ? "" : "text-neutral-500 line-through")">
                        @type.Name
                    </span>
                    @if (type.IsBuiltIn)
                    {
                        <span class="border border-neutral-400 px-1 text-xs text-neutral-600">Built-in</span>
                    }
                    @if (!type.IsActive)
                    {
                        <span class="border border-neutral-400 px-1 text-xs text-neutral-600">Inactive</span>
                    }
                </span>

                <form method="post" action="/types/@type.Id/@(type.IsActive ? "deactivate" : "activate")"
                      asp-antiforgery="true" class="shrink-0">
                    <button type="submit"
                            class="border border-black bg-white px-3 py-1 text-sm text-black hover:bg-black hover:text-white">
                        @(type.IsActive ? "Deactivate" : "Activate")
                    </button>
                </form>
            </li>
        }
    </ul>

    <p class="mt-3 text-xs text-neutral-500">
        Deactivating hides a type from the day view. Entries already logged under it are kept.
    </p>
</section>
