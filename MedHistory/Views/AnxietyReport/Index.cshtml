@model AnxietyReportViewModel
@{
    ViewData["Title"] = $"Anxiety — {Model.Month.Label(CultureInfo.CurrentUICulture)}";
}

<header class="flex items-center justify-between gap-4 border-b border-black pb-4 dark:border-neutral-100">
    <a href="/anxiety-report/@Model.Month.PreviousKey" title="Previous month"
       class="border border-black px-3 py-1 text-sm hover:bg-black hover:text-white dark:border-neutral-100 dark:hover:bg-neutral-100 dark:hover:text-neutral-950">&larr;</a>

    <div class="text-center">
        <h1 class="font-semibold">@Model.Month.Label(CultureInfo.CurrentUICulture)</h1>
        <p class="text-xs uppercase tracking-wide text-neutral-500 dark:text-neutral-400">@Model.Month.ProgressLabel</p>
    </div>

    <a href="/anxiety-report/@Model.Month.NextKey" title="Next month"
       class="border border-black px-3 py-1 text-sm hover:bg-black hover:text-white dark:border-neutral-100 dark:hover:bg-neutral-100 dark:hover:text-neutral-950">&rarr;</a>
</header>

<div class="mt-4 flex items-center gap-4 text-sm">
    @if (!Model.IsCurrentMonth)
    {
        <a href="/anxiety-report" class="underline hover:no-underline">This month</a>
    }
    <a href="/" class="ml-auto underline hover:no-underline">Back to today</a>
</div>

@* Weeks run Monday first, sharing the med report's column order — see
   ReportRules.WeekdayLabels and ReportRules.LeadingBlanks. *@
<div class="mt-6 grid grid-cols-7 gap-1 text-center text-xs uppercase tracking-wide text-neutral-500 dark:text-neutral-400">
    @foreach (var weekday in ReportRules.WeekdayLabels(CultureInfo.CurrentUICulture))
    {
        <div>@weekday</div>
    }
</div>

@* A voted cell carries the day's number and the level's own emoji face — the emoji alone
   carries the level, so every in-month cell gets the same plain treatment. Every real day of
   the month gets a cell, voted or not; only days of the neighbouring month are left blank,
   same as the med report. *@
<div class="mt-1 grid grid-cols-7 gap-1">
    @foreach (var week in Model.Month.Weeks)
    {
        @foreach (var cell in week.Days)
        {
            @if (cell is null)
            {
                @* A day of the neighbouring month: the column is held, nothing is drawn in it. *@
                <div></div>
            }
            else
            {
                var tally = cell.Value;
                var date = tally.Day;

                var state = "border-neutral-300 bg-white hover:bg-neutral-100 dark:border-neutral-600 dark:bg-neutral-800 dark:hover:bg-neutral-700";

                var label = tally.Level is null
                    ? $"{AppTime.DayLabel(date, CultureInfo.CurrentUICulture)} — no vote"
                    : $"{AppTime.DayLabel(date, CultureInfo.CurrentUICulture)} — {AnxietyRules.Label(tally.Level.Value)}";

                <a href="/day/@AppTime.Key(date)" title="@label" aria-label="@label"
                   class="flex min-h-14 flex-col items-center justify-center gap-1 border p-1 leading-none @state">
                    <span class="text-sm tabular-nums @(tally.Level is null ? "text-neutral-400 dark:text-neutral-500" : "") @(date == Model.Today ? "underline underline-offset-2" : "")">@date.Day</span>
                    @if (tally.Level is not null)
                    {
                        <span class="text-lg">@AnxietyRules.Emoji(tally.Level.Value)</span>
                    }
                </a>
            }
        }
    }
</div>

<div class="mt-4 text-xs text-neutral-500 dark:text-neutral-400">
    😌 calm &middot; 🙂 ok &middot; 😟 tense &middot; 😰 anxious &middot; 😱 panic
</div>
