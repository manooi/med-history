@model LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = "_Layout";
}

<div class="min-h-screen flex items-center justify-center bg-white px-4 dark:bg-neutral-800">
    <div class="w-full max-w-sm">
        <h1 class="text-2xl font-semibold text-black mb-6 text-center dark:text-neutral-100">MedHistory</h1>

        <form asp-controller="Account" asp-action="Login" method="post" class="border border-neutral-300 rounded-lg p-6 space-y-4 dark:border-neutral-600">
            <input type="hidden" asp-for="ReturnUrl" />

            <div asp-validation-summary="ModelOnly" class="text-sm text-neutral-900 dark:text-neutral-100"></div>

            <div>
                <label asp-for="Password" class="block text-sm font-medium text-neutral-700 mb-1 dark:text-neutral-300">Password</label>
                <input asp-for="Password" type="password" autocomplete="current-password" autofocus
                       class="w-full border border-neutral-400 rounded-md px-3 py-2 text-black focus:outline-none focus:ring-2 focus:ring-black dark:border-neutral-500 dark:bg-neutral-800 dark:text-neutral-100 dark:focus:ring-neutral-100" />
            </div>

            <button type="submit" class="w-full bg-black text-white rounded-md py-2 font-medium hover:bg-neutral-800 dark:bg-neutral-100 dark:text-neutral-950 dark:hover:bg-neutral-300">
                Sign in
            </button>
        </form>
    </div>
</div>
