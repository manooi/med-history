@model EntryFormViewModel
@{
    var isEdit = Model.IsEdit;
    ViewData["Title"] = $"{(isEdit ? "Edit" : "New")} {Model.Type}";

    var postUrl = isEdit ? $"/entries/{Model.Id}" : "/entries";
    var cancelDay = Model.OccurredAt == default ? AppTime.Today() : DateOnly.FromDateTime(Model.OccurredAt);
    var fieldClass = "mt-1 w-full border border-black bg-white px-2 py-1 text-sm text-black dark:border-neutral-100 dark:bg-neutral-950 dark:text-neutral-100";
}

<h1 class="border-b border-black pb-4 font-semibold dark:border-neutral-100">@(isEdit ? "Edit" : "New") @Model.Type</h1>

<form method="post" action="@postUrl" enctype="multipart/form-data" asp-antiforgery="true" class="mt-6 space-y-4">
    <input type="hidden" name="Type" value="@Model.Type" />
    @if (isEdit)
    {
        <input type="hidden" name="Id" value="@Model.Id" />
    }

    <div asp-validation-summary="All" class="text-sm text-neutral-700 dark:text-neutral-300"></div>

    <div>
        <label for="OccurredAt" class="block text-sm font-medium">Time</label>
        <input type="datetime-local" id="OccurredAt" name="OccurredAt" required
               value="@AppTime.InputValue(Model.OccurredAt)" class="@fieldClass" />
        <div class="mt-1 flex gap-2">
            @foreach (var preset in new[] { "09:00", "12:00", "18:00" })
            {
                <button type="button" data-time-preset="@preset"
                        class="border border-black bg-white px-2 py-1 text-sm hover:bg-black hover:text-white dark:border-neutral-100 dark:bg-neutral-950 dark:text-neutral-100 dark:hover:bg-neutral-100 dark:hover:text-neutral-950">
                    @preset
                </button>
            }
        </div>
    </div>

    @if (EntryRules.RequiresSeverity(Model.Type))
    {
        <div>
            <label asp-for="Severity" class="block text-sm font-medium">Severity</label>
            <select asp-for="Severity" asp-items="Html.GetEnumSelectList<Severity>()" class="@fieldClass"></select>
        </div>
    }

    @if (EntryRules.RequiresPillName(Model.Type))
    {
        <div>
            <label asp-for="PillName" class="block text-sm font-medium">Med name</label>
            <input asp-for="PillName" type="text" autocomplete="off" class="@fieldClass" />
        </div>
    }

    <div>
        <label asp-for="Note" class="block text-sm font-medium">
            Note@(EntryRules.RequiresNote(Model.Type) ? "" : " (optional)")
        </label>
        <textarea asp-for="Note" rows="3" class="@fieldClass"></textarea>
    </div>

    <div>
        <label for="photos" class="block text-sm font-medium">
            Photos <span class="font-normal text-neutral-500 dark:text-neutral-400">(optional, up to @(PhotoRules.MaxSizeBytes / (1024 * 1024)) MB each)</span>
        </label>
        <input type="file" id="photos" name="photos" multiple accept="image/*"
               class="mt-1 w-full border border-black bg-white px-2 py-1 text-sm text-black file:mr-3 file:border file:border-black file:bg-white file:px-2 file:py-0.5 file:text-sm file:text-black hover:file:bg-black hover:file:text-white dark:border-neutral-100 dark:bg-neutral-950 dark:text-neutral-100 dark:file:border-neutral-100 dark:file:bg-neutral-950 dark:file:text-neutral-100 dark:hover:file:bg-neutral-100 dark:hover:file:text-neutral-950" />
    </div>

    <div class="flex items-center gap-3 pt-2">
        <button type="submit"
                class="border border-black bg-white px-4 py-1 text-sm text-black hover:bg-black hover:text-white dark:border-neutral-100 dark:bg-neutral-950 dark:text-neutral-100 dark:hover:bg-neutral-100 dark:hover:text-neutral-950">
            Save
        </button>
        <a href="/day/@AppTime.Key(cancelDay)" class="text-sm underline hover:no-underline">Cancel</a>
    </div>
</form>

@if (isEdit && Model.ExistingPhotos.Count > 0)
{
    <div class="mt-8 border-t border-neutral-300 pt-4 dark:border-neutral-700">
        <span class="block text-sm font-medium">Existing photos</span>
        <ul class="mt-2 flex flex-wrap gap-3">
            @foreach (var photo in Model.ExistingPhotos)
            {
                <li class="flex flex-col items-center gap-1">
                    <img src="/photos/@photo.Id" loading="lazy" alt="@photo.FileName" data-lightbox
                         class="h-20 w-20 max-h-20 border border-neutral-400 object-cover cursor-zoom-in dark:border-neutral-600" />
                    <form method="post" action="/photos/@photo.Id/delete" asp-antiforgery="true">
                        <button type="submit" onclick="return confirm('Remove this photo?');"
                                class="text-xs text-red-600 underline hover:no-underline dark:text-red-400">
                            Remove
                        </button>
                    </form>
                </li>
            }
        </ul>
    </div>
}

@if (isEdit)
{
    <form method="post" action="/entries/@Model.Id/delete" asp-antiforgery="true"
          class="mt-10 border-t border-neutral-300 pt-4 dark:border-neutral-700">
        <button type="submit" onclick="return confirm('Delete this entry?');"
                class="border border-red-600 bg-white px-4 py-1 text-sm text-red-600 hover:bg-red-600 hover:text-white dark:border-red-400 dark:bg-neutral-950 dark:text-red-400">
            Delete entry
        </button>
    </form>
}

@section Scripts {
    <script>
        document.querySelectorAll('[data-time-preset]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var input = document.getElementById('OccurredAt');
                if (!input.value) return;
                var datePart = input.value.split('T')[0];
                input.value = datePart + 'T' + btn.getAttribute('data-time-preset');
            });
        });

        var photosMaxSide = 1600;
        var photosGeneration = 0;

        function downscalePhoto(file) {
            return createImageBitmap(file).then(function (bitmap) {
                var longest = Math.max(bitmap.width, bitmap.height);
                if (longest <= photosMaxSide) {
                    if (bitmap.close) bitmap.close();
                    return file;
                }
                var scale = photosMaxSide / longest;
                var width = Math.round(bitmap.width * scale);
                var height = Math.round(bitmap.height * scale);
                var canvas = document.createElement('canvas');
                canvas.width = width;
                canvas.height = height;
                canvas.getContext('2d').drawImage(bitmap, 0, 0, width, height);
                if (bitmap.close) bitmap.close();
                return new Promise(function (resolve, reject) {
                    canvas.toBlob(function (blob) {
                        if (!blob) {
                            reject(new Error('toBlob failed'));
                            return;
                        }
                        var newName = file.name.replace(/\.[^./\\]*$/, '') + '.jpg';
                        resolve(new File([blob], newName, { type: 'image/jpeg', lastModified: file.lastModified }));
                    }, 'image/jpeg', 0.85);
                });
            });
        }

        var photosInput = document.getElementById('photos');
        if (photosInput) {
            photosInput.addEventListener('change', function () {
                var files = Array.prototype.slice.call(photosInput.files);
                if (files.length === 0) return;

                var generation = ++photosGeneration;

                Promise.all(files.map(function (file) {
                    if (!file.type || file.type.indexOf('image/') !== 0) {
                        return Promise.resolve(file);
                    }
                    return downscalePhoto(file).catch(function () {
                        return file;
                    });
                })).then(function (processed) {
                    if (generation !== photosGeneration) return;
                    var dt = new DataTransfer();
                    processed.forEach(function (f) { dt.items.add(f); });
                    photosInput.files = dt.files;
                });
            });
        }
    </script>
}
