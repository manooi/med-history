@model MedsViewModel
@{
    var dayKey = AppTime.Key(Model.Day);
    var dayLabel = AppTime.DayLabel(Model.Day);
    ViewData["Title"] = $"Meds — {dayLabel}";
}

<header class="flex items-center justify-between gap-4 border-b border-black pb-4">
    <div>
        <h1 class="font-semibold">Meds</h1>
        <p class="text-sm text-neutral-500">@dayLabel</p>
    </div>
    <a href="/day/@dayKey" class="border border-black px-3 py-1 text-sm hover:bg-black hover:text-white">
        Back to day
    </a>
</header>

<section class="mt-6">
    @if (Model.Allocations.Count == 0)
    {
        <p class="px-1 py-6 text-center text-sm text-neutral-500">
            Nothing allocated for this day.
        </p>
    }
    else
    {
        <ul class="border-y border-neutral-300 divide-y divide-neutral-300">
            @foreach (var item in Model.Allocations)
            {
                <li class="flex items-start gap-2 px-1 py-3">
                    <span class="min-w-0 flex-1">
                        <span class="block text-sm font-medium">@item.Name</span>
                        <span class="block text-xs text-neutral-500">
                            @* Slots are the plan: one slot is one dose, so this line is the whole requirement. *@
                            @string.Join(" · ", item.SlotLabels)
                        </span>
                        @if (item.Description.Length > 0)
                        {
                            <span class="block text-xs text-neutral-500">@item.Description</span>
                        }
                    </span>
                    <a href="/checklist/@item.Id/edit"
                       class="shrink-0 self-center px-2 py-1 text-xs text-neutral-500 hover:text-black">
                        Edit
                    </a>
                    <form method="post" action="/checklist/@item.Id/delete" asp-antiforgery="true" class="shrink-0">
                        <button type="submit" onclick="return confirm('Remove this medication from the checklist? Logged doses are kept.');"
                                aria-label="Remove from checklist"
                                class="px-2 py-1 text-sm leading-none text-neutral-400 hover:text-black">
                            &times;
                        </button>
                    </form>
                </li>
            }
        </ul>
    }

    @if (Model.CanCopyPreviousDay)
    {
        <form method="post" action="/day/@dayKey/meds/copy-previous" asp-antiforgery="true" class="mt-3">
            <button type="submit"
                    class="border border-black bg-white px-2 py-1 text-xs text-black hover:bg-black hover:text-white">
                Copy previous day
            </button>
        </form>
    }
</section>

<form method="post" action="/day/@dayKey/meds" asp-antiforgery="true" class="mt-6 border-t border-neutral-300 pt-6">
    <div asp-validation-summary="All" class="mb-2 text-sm text-neutral-700"></div>

    <div>
        <label for="med-name" class="block text-xs uppercase tracking-wide text-neutral-500">Medication</label>
        <input type="text" id="med-name" name="name" required autocomplete="off"
               maxlength="@ChecklistRules.NameMaxLength" value="@Model.NewMedName"
               class="mt-1 w-full border border-black bg-white px-2 py-1 text-sm text-black" />
    </div>

    <div class="mt-4 flex flex-wrap gap-2">
        <div class="min-w-0 flex-1">
            <label for="med-from" class="block text-xs uppercase tracking-wide text-neutral-500">From</label>
            <input type="date" id="med-from" name="from" value="@AppTime.Key(Model.NewMedFrom)"
                   class="mt-1 w-full border border-black bg-white px-2 py-1 text-sm text-black" />
        </div>
        <div class="min-w-0 flex-1">
            <label for="med-to" class="block text-xs uppercase tracking-wide text-neutral-500">To</label>
            <input type="date" id="med-to" name="to" value="@AppTime.Key(Model.NewMedTo)"
                   class="mt-1 w-full border border-black bg-white px-2 py-1 text-sm text-black" />
        </div>
    </div>
    @* Same day in both fields (the default) is a single-day add — this is not a separate form. *@
    <p class="mt-1 text-xs text-neutral-500">Adds to every day in range; days that already have this medication are skipped.</p>

    <fieldset class="mt-4">
        <legend class="text-xs uppercase tracking-wide text-neutral-500">Times of day</legend>
        <div class="mt-1 flex flex-wrap gap-2">
            @foreach (var slot in MedPlanRules.AllSlots)
            {
                var slotName = MedPlanRules.SlotName(slot);

                <label class="flex items-center gap-2 border border-black bg-white px-2 py-1 text-sm">
                    <input type="checkbox" name="slots" value="@slotName"
                           checked="@Model.NewMedSlots.HasFlag(slot)"
                           class="accent-black" />
                    @MedPlanRules.SlotLabel(slot)
                </label>
            }
        </div>
    </fieldset>

    <div class="mt-4 flex flex-wrap items-end gap-2">
        <div class="min-w-0 flex-1">
            <label for="med-meal" class="block text-xs uppercase tracking-wide text-neutral-500">Meal</label>
            <select id="med-meal" name="mealRelation"
                    class="mt-1 w-full border border-black bg-white px-2 py-1 text-sm text-black">
                @foreach (var relation in Enum.GetValues<MealRelation>())
                {
                    <option value="@relation" selected="@(relation == Model.NewMedMealRelation)">
                        @MedPlanRules.MealRelationOption(relation)
                    </option>
                }
            </select>
        </div>

        <div class="min-w-0 flex-1">
            <label for="med-method" class="block text-xs uppercase tracking-wide text-neutral-500">Method</label>
            <select id="med-method" name="method"
                    class="mt-1 w-full border border-black bg-white px-2 py-1 text-sm text-black">
                @foreach (var method in Enum.GetValues<MedMethod>())
                {
                    <option value="@method" selected="@(method == Model.NewMedMethod)">
                        @MedPlanRules.MethodOption(method)
                    </option>
                }
            </select>
        </div>

        <button type="submit"
                class="shrink-0 border border-black bg-white px-3 py-1 text-sm text-black hover:bg-black hover:text-white">
            Add
        </button>
    </div>
</form>
