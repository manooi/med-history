@model DayViewModel
@{
    var dayLabel = AppTime.DayLabel(Model.Day, CultureInfo.CurrentUICulture);
    var dayKey = AppTime.Key(Model.Day);
    ViewData["Title"] = dayLabel;
}

<header class="flex items-center justify-between gap-4 border-b border-black pb-4 dark:border-neutral-100">
    <a href="/day/@AppTime.Key(Model.PreviousDay)" title="@Localizer.GetString("Previous day")"
       class="border border-black px-3 py-1 text-sm hover:bg-black hover:text-white dark:border-neutral-100 dark:hover:bg-neutral-100 dark:hover:text-neutral-950">&larr;</a>

    <div class="text-center">
        <h1 class="font-semibold">@dayLabel</h1>
        @if (Model.IsToday)
        {
            <p class="text-xs uppercase tracking-wide text-neutral-500 dark:text-neutral-400">@L["Today"]</p>
        }
    </div>

    <a href="/day/@AppTime.Key(Model.NextDay)" title="@Localizer.GetString("Next day")"
       class="border border-black px-3 py-1 text-sm hover:bg-black hover:text-white dark:border-neutral-100 dark:hover:bg-neutral-100 dark:hover:text-neutral-950">&rarr;</a>
</header>

<div class="mt-4 flex items-center justify-between gap-3">
    <input type="date" id="day-picker" value="@dayKey" aria-label="@Localizer.GetString("Jump to date")"
           class="border border-black bg-white px-2 py-1 text-sm dark:border-neutral-100 dark:bg-neutral-800 dark:text-neutral-100" />
    @if (!Model.IsToday)
    {
        <a href="/" class="text-sm underline hover:no-underline">@L["Back to today"]</a>
    }
</div>

@* Both regions a tick changes are wrapped and named here so the script below can replace them
   in place — the same two wrappers _DayLive renders as the response to a tick. *@
<div id="checklist-region">
    <partial name="_Checklist" model="Model" />
</div>

<partial name="_Anxiety" model="Model" />

<partial name="_Weight" model="Model" />

<div class="mt-6 flex flex-wrap gap-2">
    @foreach (var type in Model.NewEntryTypes)
    {
        @* Names are user-supplied, so they are escaped into the query string. *@
        <a href="/entries/new?type=@Uri.EscapeDataString(type)&amp;date=@dayKey"
           class="border border-black bg-white px-3 py-1 text-sm text-black hover:bg-black hover:text-white dark:border-neutral-100 dark:bg-neutral-800 dark:text-neutral-100 dark:hover:bg-neutral-100 dark:hover:text-neutral-950">+ @type</a>
    }
    @if (Model.NewEntryTypes.Count == 0)
    {
        <a href="/types" class="text-sm underline hover:no-underline">@Localizer["No active types — manage types"]</a>
    }
</div>

<div id="entries-region">
    <partial name="_Entries" model="Model" />
</div>

@section Scripts {
    <script>
        document.getElementById('day-picker').addEventListener('change', function () {
            if (this.value) {
                window.location.href = '/day/' + this.value;
            }
        });
    </script>
    <script>
        (function () {
            // Ticking a dose is the most-used control on the app, and a full post threw the
            // page away to redraw the same page. The forms stay ordinary posts — this only
            // intercepts them, and hands the submit straight back to the browser the moment
            // anything is off, so what the reader sees is never state the server did not send.
            var checklistPost = /^\/checklist\/\d+\/(tick|untick)\/[^\/]+$/;
            var regionIds = ['checklist-region', 'entries-region'];

            // One in-flight post at a time. Two taps on the same slot would be a tick and an
            // untick racing, and the second would decide the day on arrival order alone.
            var busy = false;

            document.addEventListener('submit', function (e) {
                var form = e.target;

                if (!form.action || !checklistPost.test(new URL(form.action, window.location.href).pathname)) {
                    return;
                }

                e.preventDefault();

                if (busy) {
                    return;
                }
                busy = true;

                // Read before the swap: the panel is collapsed by default, so re-rendering it
                // would shut it under the reader mid-checklist, and the tapped button is about
                // to be replaced by its opposite — the slot key is what finds it again.
                var body = new FormData(form);
                var button = form.querySelector('button[type=submit]');
                var slot = button ? button.getAttribute('data-slot') : null;
                var panel = document.querySelector('#checklist-region details');
                var wasOpen = panel ? panel.open : false;

                if (button) {
                    button.disabled = true;
                }

                function fallBack() {
                    if (button) {
                        button.disabled = false;
                    }
                    busy = false;
                    form.submit();
                }

                fetch(form.action, {
                    method: 'POST',
                    body: body,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    credentials: 'same-origin'
                }).then(function (response) {
                    if (!response.ok) {
                        fallBack();
                        return;
                    }

                    return response.text().then(function (html) {
                        var fresh = new DOMParser().parseFromString(html, 'text/html');
                        var swapped = regionIds.every(function (id) {
                            var next = fresh.getElementById(id);
                            var here = document.getElementById(id);
                            if (!next || !here) {
                                return false;
                            }
                            here.innerHTML = next.innerHTML;
                            return true;
                        });

                        if (!swapped) {
                            fallBack();
                            return;
                        }

                        var reopened = document.querySelector('#checklist-region details');
                        if (reopened) {
                            reopened.open = wasOpen;
                        }

                        if (slot) {
                            var focused = document.querySelector('#checklist-region [data-slot="' + slot + '"]');
                            if (focused) {
                                focused.focus();
                            }
                        }

                        busy = false;
                    });
                }).catch(fallBack);
            });
        })();
    </script>
}
