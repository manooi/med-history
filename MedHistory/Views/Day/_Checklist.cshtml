@model DayViewModel
@{
    var dayKey = AppTime.Key(Model.Day);
}

@* Progress is derived from the day's Pill entries, so a row moves whether the user ticks
   here or logs the pill by hand from the timeline. *@
<section class="mt-6 border border-black">
    <div class="flex items-center justify-between gap-3 border-b border-black px-3 py-2">
        <h2 class="text-sm font-semibold uppercase tracking-wide">Meds</h2>
        @if (Model.CanCopyPreviousDay)
        {
            <form method="post" action="/day/@dayKey/checklist/copy-previous" asp-antiforgery="true">
                <button type="submit"
                        class="border border-black bg-white px-2 py-1 text-xs text-black hover:bg-black hover:text-white">
                    Copy previous day
                </button>
            </form>
        }
    </div>

    @if (Model.Checklist.Count == 0)
    {
        <p class="px-3 py-6 text-center text-sm text-neutral-500">
            Nothing allocated for this day.
        </p>
    }
    else
    {
        <ul class="divide-y divide-neutral-300">
            @foreach (var item in Model.Checklist)
            {
                <li class="flex items-center gap-2 px-3 py-3">
                    <span class="min-w-0 flex-1 text-sm font-medium @(item.IsComplete ? "text-neutral-500 line-through" : "")">
                        @item.Name
                    </span>

                    @* Done state is carried by weight and fill, never colour. *@
                    <span class="shrink-0 border px-2 py-0.5 text-xs tabular-nums @(item.IsComplete ? "border-black bg-black text-white" : "border-neutral-400 text-neutral-600")">
                        @item.DisplayCount/@item.RequiredCount
                    </span>

                    @if (item.CanUntick)
                    {
                        <form method="post" action="/checklist/@item.AllocationId/untick" asp-antiforgery="true" class="shrink-0">
                            <button type="submit" title="Undo the latest dose" aria-label="Undo the latest dose"
                                    class="border border-black bg-white px-2 py-1 text-sm leading-none text-black hover:bg-black hover:text-white">
                                &minus;
                            </button>
                        </form>
                    }

                    <form method="post" action="/checklist/@item.AllocationId/tick" asp-antiforgery="true" class="shrink-0">
                        <button type="submit" title="Log a dose" aria-label="Log a dose"
                                class="border border-black bg-white px-2 py-1 text-sm leading-none text-black hover:bg-black hover:text-white">
                            +
                        </button>
                    </form>

                    <form method="post" action="/checklist/@item.AllocationId/delete" asp-antiforgery="true" class="shrink-0">
                        <button type="submit" onclick="return confirm('Remove this medication from the checklist? Logged doses are kept.');"
                                aria-label="Remove from checklist"
                                class="px-2 py-1 text-sm leading-none text-neutral-400 hover:text-black">
                            &times;
                        </button>
                    </form>
                </li>
            }
        </ul>
    }

    <form method="post" action="/day/@dayKey/checklist" asp-antiforgery="true" class="border-t border-neutral-300 px-3 py-3">
        <div asp-validation-summary="All" class="mb-2 text-sm text-neutral-700"></div>

        <div class="flex items-end gap-2">
            <div class="min-w-0 flex-1">
                <label for="med-name" class="block text-xs uppercase tracking-wide text-neutral-500">Medication</label>
                <input type="text" id="med-name" name="name" required autocomplete="off"
                       maxlength="@ChecklistRules.NameMaxLength" value="@Model.NewMedName"
                       class="mt-1 w-full border border-black bg-white px-2 py-1 text-sm text-black" />
            </div>

            <div class="w-16 shrink-0">
                <label for="med-count" class="block text-xs uppercase tracking-wide text-neutral-500">Times</label>
                <input type="number" id="med-count" name="requiredCount" required
                       min="@ChecklistRules.MinRequiredCount" max="@ChecklistRules.MaxRequiredCount"
                       value="@Model.NewMedRequiredCount"
                       class="mt-1 w-full border border-black bg-white px-2 py-1 text-sm tabular-nums text-black" />
            </div>

            <button type="submit"
                    class="shrink-0 border border-black bg-white px-3 py-1 text-sm text-black hover:bg-black hover:text-white">
                Add
            </button>
        </div>
    </form>
</section>
