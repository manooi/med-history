@model DayViewModel
@{
    var dayKey = AppTime.Key(Model.Day);

    // The summary line is a resource key plus the numbers it carries, never a finished sentence:
    // the counting stays in ChecklistRules and the formatting happens against the *translated*
    // string, so Thai can put the two counts where Thai wants them.
    var progress = ChecklistRules.Progress(Model.Checklist);

    // Meal and method words come out of MedPlanRules in English — the very words a tick writes
    // into an entry's stored note — so they are translated here, where they are read, and never
    // where they are written. A description arrives already joined, so it is split back on
    // MedPlanRules.PartSeparator — the constant it was joined with, never a copy of it — and each
    // part looked up on its own. Both meds screens render the same words the same way; a per-view
    // file inherits nothing, so all three carry them, and ResourceLayoutTests drives the rules'
    // own output through this same split.
    string Words(IEnumerable<string> parts) =>
        string.Join(MedPlanRules.PartSeparator,
            parts.Select(part => Localizer.GetString(part).Value));
}

@* A slot is ticked exactly when the entry its control created still exists, so deleting that
   entry from the timeline unticks the slot on the next render. Hand-typed Med entries tick
   nothing. Adding, removing and copying forward allocations happens on the /meds maintenance
   page, reached via the Manage link — which lives in the body, not the summary, because a link
   nested inside <summary> toggles unreliably across browsers. Collapsed by default: the
   progress label in the summary is what the day should be judged by without opening it. *@
<details class="group mt-6 border border-black dark:border-neutral-100">
    <summary class="flex list-none cursor-pointer items-center gap-2 border-b border-black px-3 py-2 hover:bg-neutral-100 dark:border-neutral-100 dark:hover:bg-neutral-700 [&::-webkit-details-marker]:hidden">
        <h2 class="text-sm font-semibold uppercase tracking-wide">@Localizer["Meds"]</h2>
        <span class="text-xs text-neutral-500 dark:text-neutral-400">@Localizer[progress.Key, progress.Args]</span>
        @* Own marker, not the native one — killed above the same way the mobile nav kills it. *@
        <span aria-hidden="true" class="ml-auto transition-transform group-open:rotate-90">&#9656;</span>
    </summary>

    <div class="flex justify-end border-b border-black px-3 py-2 dark:border-neutral-100">
        <a href="/day/@dayKey/meds"
           class="border border-black bg-white px-2 py-1 text-xs text-black hover:bg-black hover:text-white dark:border-neutral-100 dark:bg-neutral-800 dark:text-neutral-100 dark:hover:bg-neutral-100 dark:hover:text-neutral-950">
            @Localizer["Manage"]
        </a>
    </div>

    @if (Model.Checklist.Count == 0)
    {
        <p class="px-3 py-6 text-center text-sm text-neutral-500 dark:text-neutral-400">
            @Localizer["Nothing allocated for this day."]
        </p>
    }
    else
    {
        <ul class="divide-y divide-neutral-300 dark:divide-neutral-600">
            @foreach (var row in Model.Checklist)
            {
                <li class="flex flex-wrap items-center gap-x-3 gap-y-2 px-3 py-3">
                    @* Backstop for an unbreakable Thai run — see Day/_Entries. *@
                    <span class="min-w-0 flex-1 wrap-break-word">
                        <span class="flex flex-wrap items-center gap-2 text-sm font-medium @(row.IsComplete ? "text-neutral-500 line-through dark:text-neutral-400" : "")">
                            @row.Name
                            @if (row.QuantityLabel.Length > 0)
                            {
                                @* Only away from one unit; "×1" on every row would be noise. *@
                                <span class="border border-neutral-400 px-1 text-xs font-normal text-neutral-600 dark:border-neutral-500 dark:text-neutral-400">
                                    @row.QuantityLabel
                                </span>
                            }
                        </span>
                        @if (row.StockLabel is { } stock)
                        {
                            @* Stock left over the whole history, not this day's — see MedStock.
                               Null, not empty, when nothing stocks the medication: "(0 left)"
                               would claim it had run out. *@
                            <span class="block text-xs text-neutral-500 dark:text-neutral-400">@Localizer[stock.Key, stock.Args]</span>
                        }
                        @if (row.Description.Length > 0)
                        {
                            <span class="block text-xs text-neutral-500 dark:text-neutral-400">@Words(row.Description.Split(MedPlanRules.PartSeparator))</span>
                        }
                    </span>

                    @* One control per slot. Done state is carried by fill and glyph, never colour. *@
                    <span class="flex shrink-0 flex-wrap gap-1">
                        @foreach (var slot in row.Slots)
                        {
                            var action = slot.IsTicked ? "untick" : "tick";
                            @* The slot reads as a word — "morning" — which is the resource key for
                               its own translation; the rules stay pure and keep handing back the
                               English. Medication names are the user's own text and are never
                               looked up, only formatted in. *@
                            var slotLabel = L.GetString(slot.Label).Value;
                            var label = slot.IsTicked
                                ? Localizer.GetString("Undo the {0} dose of {1}", slotLabel, row.Name).Value
                                : Localizer.GetString("Log the {0} dose of {1}", slotLabel, row.Name).Value;
                            var slotKey = $"{row.AllocationId}:{slot.Name}";

                            @* leading-none keeps the chip tight around a Latin word; every Thai slot
                               name here carries a mark above the base ("เช้า", "ก่อนนอน") that a 1em
                               line box pushes into the border, so Thai alone gets the taller line —
                               see the th: variant in site.css. *@
                            <form method="post" action="/checklist/@row.AllocationId/@action/@slot.Name" asp-antiforgery="true">
                                @* Stable across a tick: the control swaps tick for untick, so this
                                   is what puts keyboard focus back on the same slot afterwards. *@
                                <button type="submit" title="@label" aria-label="@label" data-slot="@slotKey"
                                        class="border px-2 py-1 text-xs leading-none th:leading-normal tabular-nums @(slot.IsTicked ? "border-black bg-black text-white hover:bg-white hover:text-black dark:border-neutral-100 dark:bg-neutral-100 dark:text-neutral-950 dark:hover:bg-neutral-800 dark:hover:text-neutral-100" : "border-neutral-400 bg-white text-neutral-600 hover:border-black hover:bg-black hover:text-white dark:border-neutral-500 dark:bg-neutral-800 dark:text-neutral-400 dark:hover:border-neutral-100 dark:hover:bg-neutral-100 dark:hover:text-neutral-950")">
                                    @slotLabel @(slot.IsTicked ? "✓" : "□")
                                </button>
                            </form>
                        }
                    </span>
                </li>
            }
        </ul>
    }
</details>
