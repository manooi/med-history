<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MedHistory</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="theme-color" content="#000000" />
</head>
<body class="bg-white text-black">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <nav class="border-b border-black print:hidden">
            <div class="max-w-2xl mx-auto px-4 py-4 flex items-center justify-between">
                <a href="/" class="font-mono font-bold tracking-tight hover:underline">med-history</a>
                <div class="flex items-center gap-4 text-sm">
                    <a href="/" class="hover:underline">Today</a>
                    <a href="/history" class="hover:underline">History</a>
                    <div class="group relative inline-block">
                        <a href="/report" class="hover:underline">Reports ▾</a>
                        <div class="absolute left-0 z-10 hidden w-44 flex-col border border-black bg-white text-black group-hover:flex">
                            <a href="/med-report" class="px-3 py-2 hover:bg-black hover:text-white">Med</a>
                            <a href="/anxiety-report" class="px-3 py-2 hover:bg-black hover:text-white">Anxiety</a>
                            <a href="/type-report" class="px-3 py-2 hover:bg-black hover:text-white">Type</a>
                            <a href="/doctor-report" class="px-3 py-2 hover:bg-black hover:text-white">Doctor</a>
                        </div>
                    </div>
                    <a href="/search" class="hover:underline">Search</a>
                    <a href="/types" class="hover:underline">Types</a>
                    <form method="post" action="/logout" class="inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="hover:underline bg-transparent border-0 p-0">Logout</button>
                    </form>
                </div>
            </div>
        </nav>
    }
    <main class="max-w-2xl mx-auto px-4 py-6">
        @RenderBody()
    </main>
    <partial name="_Lightbox" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
