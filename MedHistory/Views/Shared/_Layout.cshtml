<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MedHistory</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-white text-black">
    <nav class="border-b border-black">
        <div class="max-w-2xl mx-auto px-4 py-4 flex items-center justify-between">
            <a href="/" class="font-semibold">med-history</a>
            <div class="flex items-center gap-4 text-sm">
                <a href="/" class="hover:underline">Today</a>
                <a href="/history" class="hover:underline">History</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form method="post" action="/logout" class="inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="hover:underline bg-transparent border-0 p-0 cursor-pointer">Logout</button>
                    </form>
                }
            </div>
        </div>
    </nav>
    <main class="max-w-2xl mx-auto px-4 py-6">
        @RenderBody()
    </main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
