@using System.Globalization
@{
    // The language toggle. Unlike the theme toggle — which is inherently client-side — this one is
    // a plain form post, so it keeps working with scripting off, and the server renders the chosen
    // language on the first paint instead of correcting it afterwards. Rendered twice (desktop bar,
    // mobile panel), so nothing about it may key off an id.
    var uiCulture = CultureInfo.CurrentUICulture;
    var nextCulture = CultureRules.Toggle(uiCulture.Name);
    var nextCultureLabel = CultureRules.ShortLabel(nextCulture);
    var nextCultureAria = $"Switch to {CultureRules.LanguageName(nextCulture)}";
    var cultureReturnUrl = Context.Request.GetEncodedPathAndQuery();
}
<!DOCTYPE html>
<html lang="@uiCulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MedHistory</title>
    @* Ahead of the stylesheet so the theme is decided before the first paint, never corrected
       after it. The stored override wins over the system preference; anything else means
       "auto". The navbar toggle reads and writes the page's theme through medTheme. *@
    <script>
        (function () {
            var media = window.matchMedia('(prefers-color-scheme: dark)');

            function stored() {
                var value = localStorage.getItem('theme');
                return value === 'dark' || value === 'light' ? value : null;
            }

            function apply() {
                document.documentElement.dataset.theme = stored() || (media.matches ? 'dark' : 'light');
            }

            window.medTheme = {
                mode: function () {
                    return stored() || 'auto';
                },
                set: function (mode) {
                    if (mode === 'auto') {
                        localStorage.removeItem('theme');
                    } else {
                        localStorage.setItem('theme', mode);
                    }
                    apply();
                }
            };

            apply();

            // The system only gets a say while the reader has not overridden it.
            media.addEventListener('change', function () {
                if (!stored()) {
                    apply();
                }
            });
        })();
    </script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icons/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="theme-color" content="#000000" />
</head>
<body class="bg-white text-black dark:bg-neutral-800 dark:text-neutral-100">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <nav class="relative border-b border-black dark:border-neutral-100 print:hidden">
            <div class="max-w-2xl mx-auto px-4 py-4 flex items-center justify-between">
                <a href="/" class="font-mono font-bold tracking-tight hover:underline whitespace-nowrap flex-1 sm:flex-none">med-history</a>
                <div class="hidden sm:flex items-center gap-4 text-sm">
                    <a href="/" class="hover:underline">Today</a>
                    <a href="/history" class="hover:underline">History</a>
                    <div class="group relative inline-block">
                        <a href="/report" class="hover:underline">Reports ▾</a>
                        <div class="absolute left-0 z-10 hidden w-44 flex-col border border-black bg-white text-black group-hover:flex dark:border-neutral-100 dark:bg-neutral-800 dark:text-neutral-100">
                            <a href="/type-report" class="px-3 py-2 hover:bg-black hover:text-white dark:hover:bg-neutral-100 dark:hover:text-neutral-950">By type</a>
                            <a href="/med-report" class="px-3 py-2 hover:bg-black hover:text-white dark:hover:bg-neutral-100 dark:hover:text-neutral-950">Med</a>
                            <a href="/anxiety-report" class="px-3 py-2 hover:bg-black hover:text-white dark:hover:bg-neutral-100 dark:hover:text-neutral-950">Anxiety</a>
                            <a href="/weight-report" class="px-3 py-2 hover:bg-black hover:text-white dark:hover:bg-neutral-100 dark:hover:text-neutral-950">Weight</a>
                            <a href="/doctor-report" class="px-3 py-2 hover:bg-black hover:text-white dark:hover:bg-neutral-100 dark:hover:text-neutral-950">Doctor</a>
                        </div>
                    </div>
                    <a href="/search" class="hover:underline">Search</a>
                    <a href="/types" class="hover:underline">Types</a>
                    @* The button says the language a click moves to, not the one being read — two
                       letters is all that fits next to the nav links, so aria-label carries the
                       sentence. returnUrl brings the reader back to the page they switched on. *@
                    <form method="post" action="/culture" class="inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="culture" value="@nextCulture" />
                        <input type="hidden" name="returnUrl" value="@cultureReturnUrl" />
                        <button type="submit" aria-label="@nextCultureAria" class="hover:underline bg-transparent border-0 p-0">@nextCultureLabel</button>
                    </form>
                    @* The icon shows the mode the page is in, not the one a click would move to.
                       Only the script knows which that is, so the markup ships the auto icon as a
                       placeholder — there is something to see either way — and the script below
                       — inline, so it runs before the nav is painted — swaps in the real one.
                       The icons stroke currentColor, so they take the ink of whichever theme is
                       live; with no visible text left, aria-label carries the whole meaning. *@
                    <button type="button" class="theme-toggle inline-flex items-center justify-center bg-transparent border-0 p-2 -m-2 hover:opacity-70">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" class="h-5 w-5" aria-hidden="true"><circle cx="12" cy="12" r="6.5"/><path d="M12 5.5a6.5 6.5 0 0 1 0 13z" fill="currentColor" stroke="none"/></svg>
                    </button>
                    <form method="post" action="/logout" class="inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="hover:underline bg-transparent border-0 p-0">Logout</button>
                    </form>
                </div>
                @* Mobile bar reads brand / menu / theme left-to-right. Brand and the theme wrapper
                   are both flex-1 so they claim equal shares and the auto-width details lands
                   exactly centered between them — the chevron is the menu's only affordance now,
                   so it needs the middle of the bar, not a corner. All three stay position:static
                   on purpose: the panel below is absolute against nav.relative and spans the full
                   bar, which a positioned ancestor would break. *@
                <details class="group sm:hidden">
                    <summary class="list-none [&::-webkit-details-marker]:hidden cursor-pointer inline-flex items-center justify-center p-2 -m-2 hover:opacity-70" aria-label="Menu">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 transition-transform group-open:rotate-180" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
                    </summary>
                    <div class="absolute left-0 right-0 z-10 flex flex-col border border-black bg-white text-black dark:border-neutral-100 dark:bg-neutral-800 dark:text-neutral-100">
                        <a href="/" class="px-4 py-3 hover:bg-black hover:text-white dark:hover:bg-neutral-100 dark:hover:text-neutral-950">Today</a>
                        <a href="/history" class="px-4 py-3 hover:bg-black hover:text-white dark:hover:bg-neutral-100 dark:hover:text-neutral-950">History</a>
                        <a href="/report" class="px-4 py-3 hover:bg-black hover:text-white dark:hover:bg-neutral-100 dark:hover:text-neutral-950">Reports</a>
                        <a href="/search" class="px-4 py-3 hover:bg-black hover:text-white dark:hover:bg-neutral-100 dark:hover:text-neutral-950">Search</a>
                        <a href="/types" class="px-4 py-3 hover:bg-black hover:text-white dark:hover:bg-neutral-100 dark:hover:text-neutral-950">Types</a>
                        <form method="post" action="/culture">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="culture" value="@nextCulture" />
                            <input type="hidden" name="returnUrl" value="@cultureReturnUrl" />
                            <button type="submit" aria-label="@nextCultureAria" class="w-full px-4 py-3 text-left bg-transparent border-0 hover:bg-black hover:text-white dark:hover:bg-neutral-100 dark:hover:text-neutral-950">@nextCultureLabel</button>
                        </form>
                        <form method="post" action="/logout">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="w-full px-4 py-3 text-left bg-transparent border-0 hover:bg-black hover:text-white dark:hover:bg-neutral-100 dark:hover:text-neutral-950">Logout</button>
                        </form>
                    </div>
                </details>
                <div class="flex-1 flex justify-end sm:hidden">
                    <button type="button" class="theme-toggle inline-flex items-center justify-center bg-transparent border-0 p-2 -m-2 hover:opacity-70">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" class="h-5 w-5" aria-hidden="true"><circle cx="12" cy="12" r="6.5"/><path d="M12 5.5a6.5 6.5 0 0 1 0 13z" fill="currentColor" stroke="none"/></svg>
                    </button>
                </div>
                <script>
                    (function () {
                        var buttons = document.querySelectorAll('.theme-toggle');
                        var next = { auto: 'dark', dark: 'light', light: 'auto' };

                        // Trusted constants, never user data — safe to hand to innerHTML. Auto is a
                        // plain half-filled circle, which reads as neither the solid moon nor the
                        // rayed sun, so the three states stay tellable apart at 20px.
                        var icons = {
                            light: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" class="h-5 w-5" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 2.2v2.8M12 19v2.8M2.2 12h2.8M19 12h2.8M7 7L5 5M17 17l2 2M17 7l2-2M7 17l-2 2"/></svg>',
                            dark: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>',
                            auto: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" class="h-5 w-5" aria-hidden="true"><circle cx="12" cy="12" r="6.5"/><path d="M12 5.5a6.5 6.5 0 0 1 0 13z" fill="currentColor" stroke="none"/></svg>'
                        };

                        function render() {
                            var mode = window.medTheme.mode();
                            var aria = 'Theme: ' + mode + '. Switch to ' + next[mode] + '.';
                            buttons.forEach(function (button) {
                                button.innerHTML = icons[mode];
                                button.setAttribute('aria-label', aria);
                            });
                        }

                        buttons.forEach(function (button) {
                            button.addEventListener('click', function () {
                                window.medTheme.set(next[window.medTheme.mode()]);
                                render();
                            });
                        });

                        render();
                    })();
                </script>
            </div>
        </nav>
    }
    else
    {
        @* Logged out there is no nav to hang the toggle on, but it cannot go missing: a reader who
           cannot read the English passcode prompt would have no way to reach the Thai one, and the
           anonymous /culture endpoint exists precisely for this. Language only — no links, no theme
           toggle — right-aligned in the same container as the login card so the two line up. It
           renders ahead of RenderBody, so on the passcode screen it is never in DOM order between
           the sixth digit and the auto-submit, and a <button> raises no OS keyboard. *@
        <div class="max-w-2xl mx-auto px-4 pt-4 flex justify-end print:hidden">
            <form method="post" action="/culture">
                @Html.AntiForgeryToken()
                <input type="hidden" name="culture" value="@nextCulture" />
                <input type="hidden" name="returnUrl" value="@cultureReturnUrl" />
                <button type="submit" aria-label="@nextCultureAria" class="text-sm hover:underline bg-transparent border-0 p-0">@nextCultureLabel</button>
            </form>
        </div>
    }
    <main class="max-w-2xl mx-auto px-4 py-6">
        @RenderBody()
    </main>
    <partial name="_Lightbox" />
    <partial name="_ConfirmDialog" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
